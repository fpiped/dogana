{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dogana:wire:3:Claims",
  "title": "Claims",
  "type": "object",
  "properties": {
    "kind": {
      "const": "Claims"
    },
    "version": {
      "type": "integer",
      "const": 3
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "urn:dogana:wire:3:RegionClaim"
      },
      "minItems": 1
    }
  },
  "required": [
    "kind",
    "version",
    "regions"
  ],
  "additionalProperties": false
}
