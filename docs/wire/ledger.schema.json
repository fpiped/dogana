{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dogana:wire:2:Ledger",
  "title": "Ledger",
  "type": "object",
  "properties": {
    "kind": {
      "const": "Ledger"
    },
    "version": {
      "type": "integer",
      "const": 2
    },
    "contract": {
      "$ref": "urn:dogana:wire:2:Contract"
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "urn:dogana:wire:2:Region"
      },
      "minItems": 1
    },
    "generation": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:2:types#/$defs/nonemptyText"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "publication_id": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:2:types#/$defs/nonemptyText"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "version",
    "contract",
    "regions",
    "generation",
    "publication_id"
  ],
  "additionalProperties": false
}
