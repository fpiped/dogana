{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dogana:wire:4:types",
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "^(?:[^\\ud800-\\udfff]|[\\ud800-\\udbff][\\udc00-\\udfff])*$"
    },
    "nonemptyText": {
      "type": "string",
      "pattern": "^(?:[^\\ud800-\\udfff]|[\\ud800-\\udbff][\\udc00-\\udfff])*$",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "identifier": {
      "type": "string",
      "pattern": "^(?!__[dD][oO][gG][aA][nN][aA]_)[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
    },
    "date": {
      "type": "object",
      "properties": {
        "$date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "required": [
        "$date"
      ],
      "additionalProperties": false
    },
    "datetime": {
      "type": "object",
      "properties": {
        "$datetime": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        }
      },
      "required": [
        "$datetime"
      ],
      "additionalProperties": false
    },
    "scalar": {
      "oneOf": [
        {
          "$ref": "urn:dogana:wire:4:types#/$defs/text"
        },
        {
          "type": "integer"
        },
        {
          "$ref": "urn:dogana:wire:4:types#/$defs/date"
        },
        {
          "$ref": "urn:dogana:wire:4:types#/$defs/datetime"
        }
      ]
    },
    "window": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "urn:dogana:wire:4:types#/$defs/text"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "items": {
            "$ref": "urn:dogana:wire:4:types#/$defs/date"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "items": {
            "$ref": "urn:dogana:wire:4:types#/$defs/datetime"
          },
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "nonnegativeDuration": {
      "type": "object",
      "properties": {
        "$seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "$seconds"
      ],
      "additionalProperties": false
    },
    "positiveDuration": {
      "type": "object",
      "properties": {
        "$seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "$seconds"
      ],
      "additionalProperties": false
    },
    "checkpoint": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:4:types#/$defs/nonemptyText"
        },
        {
          "$ref": "urn:dogana:wire:4:types#/$defs/datetime"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
