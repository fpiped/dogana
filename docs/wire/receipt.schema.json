{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dogana:wire:5:Receipt",
  "title": "Receipt",
  "type": "object",
  "properties": {
    "kind": {
      "const": "Receipt"
    },
    "version": {
      "type": "integer",
      "const": 5
    },
    "manifest": {
      "$ref": "urn:dogana:wire:5:Manifest"
    },
    "contract": {
      "$ref": "urn:dogana:wire:5:Contract"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "urn:dogana:wire:5:Check"
      }
    },
    "outcome": {
      "enum": [
        "accepted",
        "rejected",
        "replayed"
      ]
    },
    "transition": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:5:Transition"
        },
        {
          "type": "null"
        }
      ]
    },
    "ledger_identity": {
      "$ref": "urn:dogana:wire:5:types#/$defs/nonemptyText"
    },
    "publication_id": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:5:types#/$defs/nonemptyText"
        },
        {
          "type": "null"
        }
      ]
    },
    "received_at": {
      "$ref": "urn:dogana:wire:5:types#/$defs/datetime"
    },
    "read_identity": {
      "$ref": "urn:dogana:wire:5:types#/$defs/nonemptyText"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:5:types#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "base_publication_id": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:5:types#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "version",
    "manifest",
    "contract",
    "checks",
    "outcome",
    "transition",
    "ledger_identity",
    "publication_id",
    "received_at",
    "read_identity",
    "source",
    "base_publication_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "properties": {
          "transition": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "transition": {
            "$ref": "urn:dogana:wire:5:Transition"
          },
          "checks": {
            "items": {
              "properties": {
                "passed": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  ]
}
