{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dogana:wire:2:Transition",
  "title": "Transition",
  "type": "object",
  "properties": {
    "kind": {
      "const": "Transition"
    },
    "version": {
      "type": "integer",
      "const": 2
    },
    "before": {
      "type": "array",
      "items": {
        "$ref": "urn:dogana:wire:2:Region"
      },
      "minItems": 1
    },
    "after": {
      "type": "array",
      "items": {
        "$ref": "urn:dogana:wire:2:Region"
      },
      "minItems": 1
    },
    "plan": {
      "$ref": "urn:dogana:wire:2:ApplyPlan"
    }
  },
  "required": [
    "kind",
    "version",
    "before",
    "after",
    "plan"
  ],
  "additionalProperties": false
}
