{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dogana:wire:4:Transition",
  "title": "Transition",
  "type": "object",
  "properties": {
    "kind": {
      "const": "Transition"
    },
    "version": {
      "type": "integer",
      "const": 4
    },
    "plan": {
      "$ref": "urn:dogana:wire:4:ApplyPlan"
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "urn:dogana:wire:4:Region"
      },
      "minItems": 1
    }
  },
  "required": [
    "kind",
    "version",
    "plan",
    "regions"
  ],
  "additionalProperties": false
}
