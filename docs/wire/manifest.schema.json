{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dogana:wire:3:Manifest",
  "title": "Manifest",
  "type": "object",
  "properties": {
    "kind": {
      "const": "Manifest"
    },
    "version": {
      "type": "integer",
      "const": 3
    },
    "table": {
      "$ref": "urn:dogana:wire:3:types#/$defs/identifier"
    },
    "shape": {
      "$ref": "urn:dogana:wire:3:types#/$defs/nonemptyText"
    },
    "produced_at": {
      "$ref": "urn:dogana:wire:3:types#/$defs/datetime"
    },
    "window": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:3:types#/$defs/window"
        },
        {
          "type": "null"
        }
      ]
    },
    "since": {
      "$ref": "urn:dogana:wire:3:types#/$defs/checkpoint"
    },
    "generation": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:3:types#/$defs/nonemptyText"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "rows": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_hash": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:3:types#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "tombstones": {
      "type": "integer",
      "minimum": 0
    },
    "content_hash": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:3:types#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "version",
    "table",
    "shape",
    "produced_at",
    "window",
    "since",
    "generation",
    "rows",
    "schema_hash",
    "tombstones",
    "content_hash"
  ],
  "additionalProperties": false
}
