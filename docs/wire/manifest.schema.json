{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dogana:wire:5:Manifest",
  "title": "Manifest",
  "type": "object",
  "properties": {
    "kind": {
      "const": "Manifest"
    },
    "version": {
      "type": "integer",
      "const": 5
    },
    "produced_at": {
      "$ref": "urn:dogana:wire:5:types#/$defs/datetime"
    },
    "parts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "urn:dogana:wire:5:types#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "urn:dogana:wire:5:Part"
      }
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:5:types#/$defs/nonemptyText"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "version",
    "produced_at",
    "parts",
    "snapshot"
  ],
  "additionalProperties": false
}
