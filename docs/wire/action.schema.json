{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dogana:wire:1:Action",
  "title": "Action",
  "type": "object",
  "properties": {
    "kind": {
      "const": "Action"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "operation": {
      "enum": [
        "replace_all",
        "replace_window",
        "upsert",
        "tombstone",
        "append"
      ]
    },
    "window": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:1:types#/$defs/window"
        },
        {
          "type": "null"
        }
      ]
    },
    "keys": {
      "$ref": "urn:dogana:wire:1:types#/$defs/keys"
    }
  },
  "required": [
    "kind",
    "version",
    "operation",
    "window",
    "keys"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "replace_window"
          }
        }
      },
      "then": {
        "properties": {
          "window": {
            "$ref": "urn:dogana:wire:1:types#/$defs/window"
          }
        }
      },
      "else": {
        "properties": {
          "window": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "not": {
              "enum": [
                "upsert",
                "tombstone"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "keys": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
