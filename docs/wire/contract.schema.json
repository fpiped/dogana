{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dogana:wire:1:Contract",
  "title": "Contract",
  "type": "object",
  "properties": {
    "kind": {
      "const": "Contract"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "table": {
      "$ref": "urn:dogana:wire:1:types#/$defs/identifier"
    },
    "key": {
      "type": "array",
      "items": {
        "$ref": "urn:dogana:wire:1:types#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "shapes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "urn:dogana:wire:1:types#/$defs/nonemptyText"
      },
      "additionalProperties": {
        "$ref": "urn:dogana:wire:1:Shape"
      }
    },
    "window_column": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:1:types#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "type": "array",
      "items": {
        "$ref": "urn:dogana:wire:1:Column"
      },
      "uniqueItems": true
    },
    "max_shrink_fraction": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness": {
      "$ref": "urn:dogana:wire:1:types#/$defs/nonnegativeDuration"
    },
    "start_at": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:1:types#/$defs/datetime"
        },
        {
          "type": "null"
        }
      ]
    },
    "cursor_column": {
      "anyOf": [
        {
          "$ref": "urn:dogana:wire:1:types#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "version",
    "table",
    "key",
    "shapes",
    "window_column",
    "schema",
    "max_shrink_fraction",
    "freshness",
    "start_at",
    "cursor_column"
  ],
  "additionalProperties": false
}
